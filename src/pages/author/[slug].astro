---
import Base from '../../layouts/Base.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { authors } from '../../lib/quotes';

export function getStaticPaths() {
  return authors.map((a) => ({ params: { slug: a.slug }, props: { author: a } }));
}
const { author } = Astro.props;
---
<Base title={author.name}>
  <h1>{author.name}</h1>
  <p class="lede">
    {author.quotes.length} saying{author.quotes.length === 1 ? '' : 's'} ·
    <a href={`/?author=${encodeURIComponent(author.name)}`}>Search only this saint</a>
  </p>
  <div class="quotes">
    {author.quotes.map((q) => <QuoteCard quote={q} />)}
  </div>
</Base>
