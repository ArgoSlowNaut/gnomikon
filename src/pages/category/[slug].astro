---
import Base from '../../layouts/Base.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { categories } from '../../lib/quotes';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}
const { category } = Astro.props;
---
<Base title={category.name}>
  <h1>{category.name}</h1>
  <p class="lede">
    {category.quotes.length} saying{category.quotes.length === 1 ? '' : 's'} ·
    <a href={`/?category=${encodeURIComponent(category.name)}`}>Search within this topic</a>
  </p>
  <div class="quotes">
    {category.quotes.map((q) => <QuoteCard quote={q} />)}
  </div>
</Base>
